{
  "name": "tubecp",
  "version": "0.2.0",
  "private": true,
  "description": "Turn YouTube research topics into chattable knowledge bases",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:mcp": "tsx mcp/server.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:dry": "tsx scripts/eval.ts --dry-run",
    "eval:stability": "tsx scripts/eval.ts --topic ai-saas-monetization --runs 3",
    "set-plan": "tsx scripts/set-user-plan.ts",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "db:migrate": "tsx scripts/migrate-app.ts",
    "auth:urls": "tsx scripts/print-auth-urls.ts",
    "validate:deploy": "tsx scripts/validate-deploy.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test"
  },
  "dependencies": {
    "@auth/neon-adapter": "^1.11.3",
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@polar-sh/nextjs": "0.9.6",
    "@polar-sh/sdk": "0.49.0",
    "@sentry/nextjs": "^11.5.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "googleapis": "^184.0.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "youtube-transcript": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@polar-sh/sdk": "0.49.0"
  }
}
