{
  "name": "tubecp",
  "version": "0.2.0",
  "private": true,
  "description": "Turn YouTube research topics into chattable knowledge bases",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:mcp": "tsx mcp/server.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:dry": "tsx scripts/eval.ts --dry-run",
    "eval:stability": "tsx scripts/eval.ts --topic ai-saas-monetization --runs 3",
    "set-plan": "tsx scripts/set-user-plan.ts",
    "db:migrate": "tsx scripts/migrate-app.ts",
    "auth:urls": "tsx scripts/print-auth-urls.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test"
  },
  "dependencies": {
    "@auth/neon-adapter": "^1.11.3",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@polar-sh/nextjs": "^0.9.6",
    "@polar-sh/sdk": "^0.49.0",
    "@sentry/nextjs": "^10.74.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "framer-motion": "^13.2.0",
    "googleapis": "^178.1.1",
    "gsap": "^3.15.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "openai": "^7.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "youtube-transcript": "^1.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
