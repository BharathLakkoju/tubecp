{
  "name": "youtube-mcp-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Turn YouTube research topics into chattable knowledge bases",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:mcp": "tsx mcp/server.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:dry": "tsx scripts/eval.ts --dry-run",
    "eval:stability": "tsx scripts/eval.ts --topic ai-saas-monetization --runs 3",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.22.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@polar-sh/nextjs": "^0.4.0",
    "@polar-sh/sdk": "^0.34.0",
    "@sentry/nextjs": "^9.30.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.9",
    "googleapis": "^148.0.0",
    "next": "^15.3.2",
    "openai": "^4.104.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0",
    "youtube-transcript": "^1.2.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^3.2.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
