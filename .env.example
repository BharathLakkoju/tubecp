# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ngrok tunnel URL (optional — run: npm run auth:urls https://YOUR-ID.ngrok-free.app)
# NGROK_URL=https://YOUR-ID.ngrok-free.app
# Local dev only: skip research/KB/chat usage limits (ignored when NODE_ENV=production)
# DEV_BYPASS_USAGE_LIMITS=true
# E2E tests only — ignored in production (see playwright.config.ts)
# E2E_AUTH_BYPASS=true
# Shown on legal pages for support, billing, and privacy requests
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ─── YouTube Data API v3 ───────────────────────────────
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Optional daily quota alert threshold (default 10000 units)
# YOUTUBE_DAILY_QUOTA_LIMIT=10000

# ─── OpenRouter (LLM + embeddings) ─────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=liquid/lfm-2.5-2.6b:free
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# ─── Auth (Auth.js / NextAuth + Neon Postgres) ─────────
# Neon: https://neon.tech → create project → connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Password reset + verification emails (Resend — https://resend.com/api-keys)
# Setup guide: docs/SETUP-RESEND.md
# Required in production — without it, register/forgot-password return 503.
# In local dev without this key, email links are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=Tubecp <onboarding@resend.dev>

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Local redirect:  http://localhost:3000/api/auth/callback/google
# ngrok redirect:  https://YOUR-ID.ngrok-free.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Local callback:  http://localhost:3000/api/auth/callback/github
# ngrok callback:  https://YOUR-ID.ngrok-free.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Polar Payments ────────────────────────────────────
# https://polar.sh → Settings → Access Tokens
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
# Create products in Polar dashboard, paste IDs here:
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_RESEARCHER=

# ─── Upstash Redis ─────────────────────────────────────
# Vercel → Storage → Marketplace → Upstash Redis → Connect
# Or create free DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (optional) ─────────────────────────────────
# See docs/SETUP-SENTRY.md
NEXT_PUBLIC_SENTRY_DSN=

# ─── Admin (operator usage dashboard at /admin/usage) ───
# Comma-separated Auth.js user IDs allowed to view /api/admin/usage
# ADMIN_USER_IDS=1

# ─── MCP (hosted + stdio — see docs/MCP-CLIENT.md) ───────
# Required in production for paid MCP tools; optional for local dev
LICENSE_KEY=
# Optional shared key for hosted /api/mcp (users can also generate per-user keys in Account)
# MCP_API_KEY=

# ─── Team plan (Polar) ─────────────────────────────────
POLAR_PRODUCT_ID_TEAM=
