# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── YouTube Data API v3 ───────────────────────────────
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ─── OpenRouter (LLM + embeddings) ─────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Clerk Auth ────────────────────────────────────────
# https://dashboard.clerk.com → Create application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Polar Payments ────────────────────────────────────
# https://polar.sh → Settings → Access Tokens
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
# Create products in Polar dashboard, paste IDs here:
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_RESEARCHER=

# ─── Upstash Redis ─────────────────────────────────────
# Vercel → Storage → Marketplace → Upstash Redis → Connect
# Or create free DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (optional) ─────────────────────────────────
# See docs/SETUP-SENTRY.md
NEXT_PUBLIC_SENTRY_DSN=

# ─── MCP (local only) ──────────────────────────────────
LICENSE_KEY=
