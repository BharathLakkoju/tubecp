                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/checkout?plan=researcher",
              "host": ["{{base_url}}"],
              "path": ["api", "checkout"],
              "query": [
                {
                  "key": "plan",
                  "value": "researcher"
