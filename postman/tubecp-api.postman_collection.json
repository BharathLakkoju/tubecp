    {
      "name": "Research Pipeline",
      "description": "Free tier (with daily limits). Typical flow: Expand → Search → Analyze → Rank",
      "item": [
        {
          "name": "1. Expand Queries",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.queries) {",
                  "    pm.collectionVariables.set('queries_json', JSON.stringify(data.queries));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"{{topic}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/research/expand",
              "host": ["{{base_url}}"],
              "path": ["api", "research", "expand"]
            },
            "description": "Generates 6-8 search queries for a topic. Counts against daily research limit."
          },
          "response": []
        },
        {
          "name": "2. Search YouTube",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"{{topic}}\",\n  \"queries\": [\n    \"AI SaaS monetization\",\n    \"AI SaaS pricing\",\n    \"AI SaaS revenue models\",\n    \"AI SaaS case study\",\n    \"how to monetize AI SaaS\"\n  ],\n  \"dateRange\": {\n    \"from\": \"2024-01-01T00:00:00Z\",\n    \"to\": \"2026-12-31T23:59:59Z\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/research/search",
              "host": ["{{base_url}}"],
              "path": ["api", "research", "search"]
            },
            "description": "Searches YouTube and pre-ranks candidates. `dateRange` is optional."
          },
          "response": []
        },
        {
          "name": "3. Analyze Video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"{{topic}}\",\n  \"video\": {\n    \"videoId\": \"dQw4w9WgXcQ\",\n    \"title\": \"How to monetize AI SaaS in 2026\",\n    \"channel\": \"SaaS Founder\",\n    \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n    \"publishedAt\": \"2026-01-01T00:00:00Z\",\n    \"duration\": \"18:42\",\n    \"description\": \"Deep dive on AI SaaS pricing, MRR, and revenue models.\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/research/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "research", "analyze"]
            },
            "description": "Analyzes a single video for relevance. Repeat for each candidate from search."
          },
          "response": []
        },
        {
          "name": "4. Rank Videos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"{{topic}}\",\n  \"queriesUsed\": [\n    \"AI SaaS monetization\",\n    \"AI SaaS pricing\"\n  ],\n  \"videosSearched\": 42,\n  \"maxVideos\": 15,\n  \"allCandidates\": [\n    {\n      \"videoId\": \"dQw4w9WgXcQ\",\n      \"title\": \"How to monetize AI SaaS in 2026\",\n      \"channel\": \"SaaS Founder\",\n      \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n      \"publishedAt\": \"2026-01-01T00:00:00Z\"\n    }\n  ],\n  \"analyses\": [\n    {\n      \"video\": {\n        \"videoId\": \"dQw4w9WgXcQ\",\n        \"title\": \"How to monetize AI SaaS in 2026\",\n        \"channel\": \"SaaS Founder\",\n        \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n        \"publishedAt\": \"2026-01-01T00:00:00Z\"\n      },\n      \"analysis\": {\n        \"videoId\": \"dQw4w9WgXcQ\",\n        \"relevanceScore\": 82,\n        \"discussesTopic\": true,\n        \"summary\": \"Covers AI SaaS pricing with real examples.\",\n        \"discussionLevel\": \"substantial\",\n        \"evidence\": [\n          {\n            \"timestamp\": 120,\n            \"text\": \"We charge $49/mo for our AI SaaS\",\n            \"relevance\": 85\n          }\n        ]\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/research/rank",
              "host": ["{{base_url}}"],
              "path": ["api", "research", "rank"]
            },
            "description": "Ranks analyzed videos and returns the final ResearchResult."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Knowledge Base",
      "description": "Requires Pro or Researcher plan. Flow: Create → Index Video → Finalize",
      "item": [
        {
          "name": "1. Create Knowledge Base",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.kbId) {",
                  "    pm.collectionVariables.set('kb_id', data.kbId);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"{{topic}}\",\n  \"rankedVideos\": [\n    {\n      \"videoId\": \"dQw4w9WgXcQ\",\n      \"title\": \"How to monetize AI SaaS in 2026\",\n      \"channel\": \"SaaS Founder\",\n      \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n      \"thumbnailUrl\": \"https://i.ytimg.com/vi/dQw4w9WgXcQ/mqdefault.jpg\",\n      \"relevanceScore\": 82,\n      \"whyRelevant\": \"Covers AI SaaS pricing with real examples.\",\n      \"discussionLevel\": \"substantial\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/knowledge-base/create",
              "host": ["{{base_url}}"],
              "path": ["api", "knowledge-base", "create"]
            },
            "description": "Creates a new knowledge base. Auto-saves kbId to collection variable."
          },
          "response": []
        },
        {
          "name": "2. Index Video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kbId\": \"{{kb_id}}\",\n  \"video\": {\n    \"videoId\": \"dQw4w9WgXcQ\",\n    \"title\": \"How to monetize AI SaaS in 2026\",\n    \"channel\": \"SaaS Founder\",\n    \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n    \"thumbnailUrl\": \"https://i.ytimg.com/vi/dQw4w9WgXcQ/mqdefault.jpg\",\n    \"relevanceScore\": 82,\n    \"whyRelevant\": \"Covers AI SaaS pricing with real examples.\",\n    \"discussionLevel\": \"substantial\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/knowledge-base/index-video",
              "host": ["{{base_url}}"],
              "path": ["api", "knowledge-base", "index-video"]
            },
            "description": "Indexes a single video transcript into the KB. Repeat for each ranked video."
          },
          "response": []
        },
        {
          "name": "3. Finalize Knowledge Base",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kbId\": \"{{kb_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/knowledge-base/finalize",
              "host": ["{{base_url}}"],
              "path": ["api", "knowledge-base", "finalize"]
            },
            "description": "Marks the knowledge base as ready for chat."
          },
          "response": []
        },
        {
          "name": "Get Knowledge Base",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "__session={{session_cookie}}",
                "disabled": false
              },
              {
                "key": "x-e2e-user-id",
                "value": "{{e2e_user_id}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/knowledge-base/{{kb_id}}",
